# FormSubmit — sends form leads to email with NO backend and NO signup/credentials.
# Each "inbox" is just a destination identifier in the request URL: either the raw
# email, or the random alias token FormSubmit gives you after the first activation
# (prefer the alias to keep the address out of the client bundle).
#
# Copy this file to .env.local, set the values, then restart `npm run dev`.
#
# FIRST-RUN ACTIVATION: the first submission to each NEW identifier triggers a
# one-time confirmation email — open it in the inbox and click "Activate" once.
# Until you do, submissions are accepted but not delivered.

# Catalog download requests (Products page)
VITE_FORMSUBMIT_PRODUCT=machinerycentre.product@yahoo.com

# All other forms (Home quick-quote, Quote, Contact, Feedback)
VITE_FORMSUBMIT_GENERAL=machinerycentre.product@yahoo.com
